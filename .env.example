# ==============================================================================
# TuStudyHub Production Environment Configuration Example
# Copy this file to .env before starting the production server on your VPS.
# ==============================================================================

# Node Environment ('production' or 'development')
NODE_ENV=production

# Application Port (standard full-stack backend port)
PORT=3000

# Canonical Production URL (your purchased domain with HTTPS)
# Example: https://tustudyhub.edu or https://study.yourdomain.com
APP_URL=https://your-domain.edu

# Cryptographic Session Secret
# Generate a cryptographically secure 48-byte (384-bit) base64 secret using:
# PowerShell:
#   $bytes = New-Object byte[] 48; $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create(); $rng.GetBytes($bytes); [Convert]::ToBase64String($bytes)
# Linux / macOS / Bash:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Generate a unique secret for each environment.
JWT_SECRET=replace_with_a_generated_secret_at_least_32_characters_long

# PostgreSQL Database Connection String
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/tustudyhub_db

# Persistent Document Storage Directory
# Files uploaded by students and lecturers will be saved to this directory on the VPS disk.
# Ensure the node process user has read and write permissions to this path.
STORAGE_DIR=/var/data/tustudyhub/uploads

# Gemini AI API Key (Required for hybrid AI quiz generation)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
